<div class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <a class="navbar-brand fw-bold" href="">
        <i class="bi bi-chess-knight me-1"></i> Schachmanager
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav me-auto">
            <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All"><i class="bi bi-house-door me-1"></i>Home</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link" href="turniere"><i class="bi bi-trophy me-1"></i>Turniere</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link" href="spieler"><i class="bi bi-people me-1"></i>Spieler</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link" href="vereine"><i class="bi bi-shield me-1"></i>Vereine</NavLink></li>
            <li class="nav-item"><NavLink class="nav-link" href="auswertung"><i class="bi bi-graph-up-arrow me-1"></i>Auswertung</NavLink></li>

            <AuthorizeView Roles="Admin,Organizer">
                <Authorized>
                    <li class="nav-item"><NavLink class="nav-link" href="youth"><i class="bi bi-person-badge me-1"></i>Jugend</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="attendance"><i class="bi bi-calendar-check me-1"></i>Anwesenheit</NavLink></li>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <li class="nav-item"><NavLink class="nav-link" href="admin/users"><i class="bi bi-person-gear me-1"></i>Benutzer</NavLink></li>
                </Authorized>
            </AuthorizeView>
        </ul>

        <ul class="navbar-nav">
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item d-flex align-items-center">
                        <span class="navbar-text text-light me-2">
                            <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
                            <span class="badge bg-primary ms-1">@(context.User.FindFirst("role")?.Value)</span>
                        </span>
                        <button class="btn btn-outline-light btn-sm" @onclick="LogoutAsync"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item"><NavLink class="nav-link" href="login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</NavLink></li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>
</div>

@code {
    [Inject] private AuthService AuthSvc { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await AuthSvc.LogoutAsync();
        Nav.NavigateTo("", forceLoad: false); // relative to <base href>, NOT "/" which ignores base href entirely
    }
}

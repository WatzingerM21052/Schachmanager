@page "/turniere/{Id:int}/standings"
@inject TournamentService TournamentSvc

<PageTitle>Schachmanager - Turniertabelle</PageTitle>

<div class="container-fluid px-4 py-3">
    <a href="turniere" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Zurück zu Turniere</a>
    <h2 class="fw-bold mt-2 mb-4"><i class="bi bi-list-ol text-primary me-2"></i>Tabelle</h2>

    @if (Standings == null)
    {
        <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Lade...</p>
    }
    else if (Standings.Count == 0)
    {
        <p class="text-muted">Noch keine Ergebnisse für dieses Turnier - über "CSV" auf der Turnierliste importieren.</p>
    }
    else
    {
        @foreach (var group in Standings.GroupBy(r => r.AgeGroup ?? (r.TeamName != null ? "Teams" : "Ohne"))
                      .OrderBy(g => g.Key.Length).ThenBy(g => g.Key))
        {
            <div class="card sm-card mb-4">
                <div class="card-header sm-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-diagram-3-fill me-2 sm-accent-text"></i>Klasse @group.Key</h5>
                    <span class="badge bg-light text-dark">@group.Count() Teilnehmer</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Rang</th><th>Name / Team</th><th>Verein</th><th class="text-center">Punkte</th><th class="text-center">Runden</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in group.OrderBy(r => r.Rank))
                            {
                                <tr>
                                    <td class="fw-bold">@RankBadge(row.Rank)</td>
                                    <td class="fw-bold">@row.DisplayName</td>
                                    <td class="text-muted small">@row.ClubName</td>
                                    <td class="text-center fw-bold sm-points">@row.Points</td>
                                    <td class="text-center text-muted">@row.TournamentsPlayed</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private List<StandingRowDto>? Standings;

    protected override async Task OnInitializedAsync()
    {
        Standings = await TournamentSvc.GetStandingsAsync(Id);
    }

    private MarkupString RankBadge(int rank) => rank switch
    {
        1 => new MarkupString($"{rank}. <i class=\"bi bi-trophy-fill text-warning ms-1\" title=\"Gold\"></i>"),
        2 => new MarkupString($"{rank}. <i class=\"bi bi-trophy-fill text-secondary ms-1\" title=\"Silber\"></i>"),
        3 => new MarkupString($"{rank}. <i class=\"bi bi-trophy-fill\" style=\"color:#cd7f32;\" title=\"Bronze\"></i>"),
        _ => new MarkupString($"{rank}."),
    };
}

@page "/hall-of-fame"
@inject HallOfFameService HallOfFameSvc

<PageTitle>Schachmanager - Hall of Fame</PageTitle>

<div class="sm-hero text-white p-5 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1 class="fw-bolder display-5 mb-2 text-white"><i class="bi bi-stars me-2 sm-accent-text"></i>Hall of Fame</h1>
                <p class="fs-5 opacity-75 fw-light mb-0" style="max-width: 600px;">Die ewige Bestenliste - ein Denkmal für alle Saisons, alle Rekorde und jede gespielte Partie.</p>
            </div>
            <div class="col-lg-5">
                <div class="d-flex justify-content-lg-end justify-content-center gap-4 gap-sm-5 text-center">
                    <div>
                        <div class="display-6 fw-bolder mb-1">@Data?.TotalPlayers</div>
                        <div class="text-uppercase small fw-bold opacity-50">Spieler</div>
                    </div>
                    <div>
                        <div class="display-6 fw-bolder mb-1">@Data?.TotalTournaments</div>
                        <div class="text-uppercase small fw-bold opacity-50">Turniere</div>
                    </div>
                    <div>
                        <div class="display-6 fw-bolder mb-1">@Data?.TotalClubs</div>
                        <div class="text-uppercase small fw-bold opacity-50">Vereine</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    @if (Data == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-xl-8">
                <div class="card sm-card">
                    <div class="sm-card-header"><h5 class="fw-bold mb-0"><i class="bi bi-trophy-fill me-2 sm-accent-text"></i>Die All-Time Punkte-Giganten</h5></div>

                    @if (Data.TopByPoints.Count >= 3)
                    {
                        <div class="d-flex align-items-end justify-content-center gap-3 py-4 px-3 bg-light" style="min-height: 220px;">
                            <div class="text-center" style="width: 30%;">
                                <div class="rounded-top-4 p-3 pt-4" style="background: linear-gradient(to bottom right,#e0e0e0,#f8f8f8,#b0b0b0); height: 140px;">
                                    <div class="fw-bold text-truncate">@Data.TopByPoints[1].Firstname @Data.TopByPoints[1].Lastname</div>
                                    <div class="small text-truncate opacity-75">@Data.TopByPoints[1].ClubName</div>
                                    <div class="fw-bolder mt-1">@Data.TopByPoints[1].TotalPoints Pkt.</div>
                                </div>
                                <div class="bg-secondary text-white fw-bold py-1 rounded-bottom-3">2</div>
                            </div>
                            <div class="text-center" style="width: 34%;">
                                <div class="rounded-top-4 p-3 pt-4" style="background: linear-gradient(to bottom right,#ffd700,#fdb931,#c08204); height: 180px;">
                                    <i class="bi bi-trophy-fill fs-2 sm-accent-text"></i>
                                    <div class="fw-bold text-truncate">@Data.TopByPoints[0].Firstname @Data.TopByPoints[0].Lastname</div>
                                    <div class="small text-truncate opacity-75">@Data.TopByPoints[0].ClubName</div>
                                    <div class="fw-bolder fs-5 mt-1">@Data.TopByPoints[0].TotalPoints Pkt.</div>
                                </div>
                                <div class="bg-warning text-dark fw-bold py-1 rounded-bottom-3">1</div>
                            </div>
                            <div class="text-center" style="width: 30%;">
                                <div class="rounded-top-4 p-3 pt-4" style="background: linear-gradient(to bottom right,#d4a373,#e6c3a1,#a67c52); height: 120px;">
                                    <div class="fw-bold text-truncate">@Data.TopByPoints[2].Firstname @Data.TopByPoints[2].Lastname</div>
                                    <div class="small text-truncate opacity-75">@Data.TopByPoints[2].ClubName</div>
                                    <div class="fw-bolder mt-1">@Data.TopByPoints[2].TotalPoints Pkt.</div>
                                </div>
                                <div style="background:#a67c52;" class="text-white fw-bold py-1 rounded-bottom-3">3</div>
                            </div>
                        </div>
                    }

                    <div class="p-3">
                        <h6 class="text-muted fw-bold text-uppercase small mb-3">Das Verfolgerfeld (Plätze 4-10)</h6>
                        <ul class="list-group list-group-flush">
                            @for (int i = 3; i < Data.TopByPoints.Count; i++)
                            {
                                var p = Data.TopByPoints[i];
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-light text-dark border me-2">@(i + 1)</span>
                                        <div>
                                            <span class="fw-bold d-block">@p.Firstname @p.Lastname</span>
                                            <span class="small text-muted">@p.ClubName</span>
                                        </div>
                                    </div>
                                    <span class="fw-bolder sm-points">@p.TotalPoints</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 d-flex flex-column gap-4">
                <div class="card sm-card p-3">
                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                        <div class="sm-icon-circle me-3"><i class="bi bi-fire"></i></div>
                        <div><h6 class="fw-bold mb-0">Die Dauerbrenner</h6><span class="text-muted small">Meiste Turnierteilnahmen</span></div>
                    </div>
                    <ul class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        @for (int i = 0; i < Data.TopByGames.Count; i++)
                        {
                            var p = Data.TopByGames[i];
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold text-muted me-2" style="width: 20px;">@(i + 1).</span>
                                    <div><span class="fw-bold d-block">@p.Firstname @p.Lastname</span><span class="small text-muted">@p.ClubName</span></div>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fw-bold">@p.TotalGames x</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="card sm-card p-3" style="background: linear-gradient(145deg,#2b2b2b,#1a1a1a); color: white;">
                    <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-secondary">
                        <div class="sm-icon-circle me-3" style="background: rgba(201,151,31,0.15); color: var(--sm-accent);"><i class="bi bi-buildings-fill"></i></div>
                        <div><h6 class="fw-bold mb-0">Top Vereine</h6><span class="text-white-50 small">Meiste unterschiedliche Spieler</span></div>
                    </div>
                    <ul class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        @for (int i = 0; i < Data.TopClubs.Count; i++)
                        {
                            var c = Data.TopClubs[i];
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center px-0">
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold sm-accent-text me-2" style="width: 20px;">@(i + 1).</span>
                                    <span class="fw-bold text-white">@c.Name</span>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill fw-bolder">@c.PlayerCount</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private HallOfFameResponse? Data;

    protected override async Task OnInitializedAsync()
    {
        Data = await HallOfFameSvc.GetAsync();
    }
}

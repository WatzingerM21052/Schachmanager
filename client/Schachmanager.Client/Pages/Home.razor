@page "/"
@inject TournamentService TournamentSvc

<PageTitle>Schachmanager - Home</PageTitle>

<div class="sm-hero text-white p-5 mb-4">
    <div class="container">
        <h1 class="display-5 fw-bold text-white"><i class="bi bi-chess-knight me-2 sm-accent-text"></i>Schachmanager</h1>
        <p class="lead opacity-75">Turnierverwaltung und Vereinsportal - alles an einem Ort.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a href="turniere" class="btn btn-warning fw-bold text-dark"><i class="bi bi-trophy me-1"></i>Turniere</a>
            <a href="auswertung" class="btn btn-outline-light"><i class="bi bi-graph-up-arrow me-1"></i>Auswertung</a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Top 5 - Schülerliga Gesamtwertung</h4>
        <a href="auswertung" class="small">Vollständige Auswertung <i class="bi bi-arrow-right"></i></a>
    </div>

    @if (Top == null)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Lade...</div>
    }
    else if (Top.Count == 0)
    {
        <p class="text-muted">Noch keine Ergebnisse vorhanden.</p>
    }
    else
    {
        <div class="card sm-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Rang</th><th>Name</th><th>Verein</th><th>Klasse</th><th class="text-center">Punkte</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Top)
                        {
                            <tr>
                                <td class="fw-bold">@row.Rank.</td>
                                <td>@row.DisplayName</td>
                                <td class="text-muted small">@row.ClubName</td>
                                <td><span class="badge @AgeGroupBadge.CssClass(row.AgeGroup)">@row.AgeGroup</span></td>
                                <td class="text-center fw-bold sm-points">@row.Points</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<StandingRowDto>? Top;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var standings = await TournamentSvc.GetLeaderboardAsync(TournamentFormats.SchuelerLiga);
            Top = standings.OrderByDescending(r => r.Points).Take(5).ToList();
        }
        catch
        {
            Top = new();
        }
    }
}

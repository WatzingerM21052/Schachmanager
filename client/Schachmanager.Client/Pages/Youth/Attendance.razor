@page "/attendance"
@attribute [Authorize(Roles = "Admin,Organizer,Member")]
@inject YouthService YouthSvc

<PageTitle>Schachmanager - Anwesenheit</PageTitle>

<div class="container-fluid px-4 py-3">
    <h2 class="fw-bold mb-3"><i class="bi bi-calendar-check text-primary me-2"></i>Anwesenheit</h2>

    <div class="mb-3 d-flex align-items-center gap-2">
        <label class="form-label mb-0">Datum:</label>
        <input type="date" class="form-control w-auto" value="@SelectedDate" @onchange="OnDateChangedAsync" />
    </div>

    @if (ErrorMessage != null)
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (Members == null)
    {
        <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Lade...</p>
    }
    else
    {
        <AuthorizeView Roles="Admin,Organizer">
            <Authorized>
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th class="text-center">Anwesend</th></tr></thead>
                    <tbody>
                        @foreach (var m in Members)
                        {
                            <tr>
                                <td>@m.Lastname @m.Firstname</td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@IsPresent(m.Id)" @onchange="e => ToggleAsync(m.Id, (bool)e.Value!)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Authorized>
            <NotAuthorized>
                <p class="text-muted">Anwesenheit ansehen erfordert Trainer/Admin-Rechte zum Bearbeiten - reine Mitglieder sehen hier nur den Status.</p>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    private List<YouthMemberDto>? Members;
    private List<AttendanceDto> TodayAttendance = new();
    private string SelectedDate = DateTime.Today.ToString("yyyy-MM-dd");
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Members = await YouthSvc.GetMembersAsync();
            TodayAttendance = await YouthSvc.GetAttendanceAsync(SelectedDate);
        }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task OnDateChangedAsync(ChangeEventArgs e)
    {
        SelectedDate = e.Value?.ToString() ?? SelectedDate;
        try { TodayAttendance = await YouthSvc.GetAttendanceAsync(SelectedDate); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private bool IsPresent(int memberId) => TodayAttendance.Any(a => a.MemberId == memberId && a.Present);

    private async Task ToggleAsync(int memberId, bool present)
    {
        try
        {
            await YouthSvc.RecordAttendanceAsync(memberId, SelectedDate, present);
            TodayAttendance.RemoveAll(a => a.MemberId == memberId);
            TodayAttendance.Add(new AttendanceDto { MemberId = memberId, Date = SelectedDate, Present = present });
        }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }
}

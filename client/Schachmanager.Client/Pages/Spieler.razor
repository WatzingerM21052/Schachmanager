@page "/spieler"
@inject PlayerService PlayerSvc
@inject ClubService ClubSvc

<PageTitle>Schachmanager - Spieler</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold"><i class="bi bi-people text-primary me-2"></i>Spieler</h2>
        <AuthorizeView Roles="Admin,Organizer">
            <Authorized>
                <button class="btn btn-primary" @onclick="StartCreate"><i class="bi bi-plus-lg me-1"></i>Neuer Spieler</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (ErrorMessage != null)
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (Players == null)
    {
        <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Lade...</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr><th>Name</th><th>Verein</th><th>Klasse</th><th>Elo</th><th>Land</th><th style="width:160px;"></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Players)
                {
                    <tr>
                        <td>@p.Lastname @p.Firstname</td>
                        <td class="text-muted small">@ClubName(p.ClubId)</td>
                        <td><span class="badge bg-secondary">@(p.AgeGroup ?? "-")</span></td>
                        <td>@(p.Elo?.ToString() ?? "-")</td>
                        <td>@p.Country</td>
                        <td>
                            <AuthorizeView Roles="Admin,Organizer">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(p)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)"><i class="bi bi-trash"></i></button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (IsEditorOpen)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.4);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(Editing.Id == 0 ? "Neuer Spieler" : "Spieler bearbeiten")</h5>
                    <button class="btn-close" @onclick="CloseEditor"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label">Vorname</label><input class="form-control" @bind="Editing.Firstname" /></div>
                        <div class="col-6"><label class="form-label">Nachname</label><input class="form-control" @bind="Editing.Lastname" /></div>
                        <div class="col-6"><label class="form-label">Geburtsjahr</label><input type="number" class="form-control" @bind="Editing.BirthYear" /></div>
                        <div class="col-6"><label class="form-label">Elo</label><input type="number" class="form-control" @bind="Editing.Elo" /></div>
                        <div class="col-6"><label class="form-label">Land</label><input class="form-control" @bind="Editing.Country" /></div>
                        <div class="col-6">
                            <label class="form-label">Verein</label>
                            <select class="form-select" @bind="Editing.ClubId">
                                <option value="">-</option>
                                @if (Clubs != null)
                                {
                                    @foreach (var c in Clubs)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditor">Abbrechen</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Speichern</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PlayerDto>? Players;
    private List<ClubDto>? Clubs;
    private string? ErrorMessage;
    private bool IsEditorOpen;
    private PlayerDto Editing = new();

    protected override async Task OnInitializedAsync()
    {
        Clubs = await ClubSvc.GetAllAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { Players = await PlayerSvc.GetAllAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private string ClubName(int? clubId) => Clubs?.FirstOrDefault(c => c.Id == clubId)?.Name ?? "Vereinslos";

    private void StartCreate() { Editing = new PlayerDto(); IsEditorOpen = true; }
    private void StartEdit(PlayerDto p) { Editing = new PlayerDto { Id = p.Id, Firstname = p.Firstname, Lastname = p.Lastname, Elo = p.Elo, Country = p.Country, BirthYear = p.BirthYear, ClubId = p.ClubId }; IsEditorOpen = true; }
    private void CloseEditor() => IsEditorOpen = false;

    private async Task SaveAsync()
    {
        try
        {
            if (Editing.Id == 0) await PlayerSvc.CreateAsync(Editing);
            else await PlayerSvc.UpdateAsync(Editing);
            IsEditorOpen = false;
            await LoadAsync();
        }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task DeleteAsync(PlayerDto p)
    {
        try { await PlayerSvc.DeleteAsync(p.Id); await LoadAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }
}

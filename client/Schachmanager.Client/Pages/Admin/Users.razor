@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserAdminService UserSvc

<PageTitle>Schachmanager - Benutzer</PageTitle>

<div class="container-fluid px-4 py-3">
    <h2 class="fw-bold mb-3"><i class="bi bi-person-gear text-primary me-2"></i>Benutzerverwaltung</h2>
    <p class="text-muted small">Konten werden ausschließlich von Admins angelegt - keine Selbstregistrierung. Passwörter werden nur direkt nach dem Anlegen/Zurücksetzen einmalig angezeigt und danach nie wieder abrufbar.</p>

    @if (ErrorMessage != null)
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    @if (LastGeneratedPassword != null)
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center">
            <span>Neues Passwort für <strong>@LastGeneratedPasswordFor</strong>: <code class="fs-6">@LastGeneratedPassword</code> (jetzt notieren - wird nicht erneut angezeigt)</span>
            <button class="btn-close" @onclick="() => LastGeneratedPassword = null"></button>
        </div>
    }

    <button class="btn btn-primary mb-3" @onclick="StartCreate"><i class="bi bi-plus-lg me-1"></i>Neuer Benutzer</button>

    @if (UserList == null)
    {
        <p class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Lade...</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Benutzername</th><th>E-Mail</th><th>Rolle</th><th>Aktiv</th><th>Letzter Login</th><th style="width:260px;"></th></tr>
            </thead>
            <tbody>
                @foreach (var u in UserList)
                {
                    <tr>
                        <td class="fw-bold">@u.Username</td>
                        <td class="text-muted small">@u.Email</td>
                        <td><span class="badge bg-info text-dark">@u.Role</span></td>
                        <td>@(u.IsActive ? "Ja" : "Nein")</td>
                        <td class="text-muted small">@u.LastLogin</td>
                        <td>
                            <select class="form-select form-select-sm d-inline-block w-auto me-1" value="@u.Role" @onchange="e => ChangeRoleAsync(u, e.Value?.ToString())">
                                <option value="Admin">Admin</option>
                                <option value="Organizer">Organizer</option>
                                <option value="Member">Member</option>
                            </select>
                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1" @onclick="() => ToggleActiveAsync(u)">
                                @(u.IsActive ? "Deaktivieren" : "Aktivieren")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ResetPasswordAsync(u)"><i class="bi bi-key"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(u)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (IsCreateOpen)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.4);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Neuer Benutzer</h5>
                    <button class="btn-close" @onclick="() => IsCreateOpen = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label">Benutzername</label><input class="form-control" @bind="NewUsername" /></div>
                    <div class="mb-2"><label class="form-label">E-Mail (optional)</label><input class="form-control" @bind="NewEmail" /></div>
                    <div class="mb-2">
                        <label class="form-label">Rolle</label>
                        <select class="form-select" @bind="NewRole">
                            <option value="Admin">Admin</option>
                            <option value="Organizer">Organizer</option>
                            <option value="Member">Member</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => IsCreateOpen = false">Abbrechen</button>
                    <button class="btn btn-primary" @onclick="CreateAsync">Anlegen</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto>? UserList;
    private string? ErrorMessage;
    private bool IsCreateOpen;
    private string NewUsername = "";
    private string NewEmail = "";
    private string NewRole = "Member";
    private string? LastGeneratedPassword;
    private string? LastGeneratedPasswordFor;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { UserList = await UserSvc.GetAllAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private void StartCreate()
    {
        NewUsername = ""; NewEmail = ""; NewRole = "Member";
        IsCreateOpen = true;
    }

    private async Task CreateAsync()
    {
        try
        {
            var created = await UserSvc.CreateAsync(NewUsername, string.IsNullOrWhiteSpace(NewEmail) ? null : NewEmail, NewRole);
            LastGeneratedPassword = created.GeneratedPassword;
            LastGeneratedPasswordFor = created.Username;
            IsCreateOpen = false;
            await LoadAsync();
        }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task ChangeRoleAsync(UserDto u, string? newRole)
    {
        if (string.IsNullOrEmpty(newRole) || newRole == u.Role) return;
        try { await UserSvc.UpdateAsync(u.Id, new UpdateUserRequest { Role = newRole }); await LoadAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task ToggleActiveAsync(UserDto u)
    {
        try { await UserSvc.UpdateAsync(u.Id, new UpdateUserRequest { IsActive = !u.IsActive }); await LoadAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task ResetPasswordAsync(UserDto u)
    {
        try
        {
            var newPassword = await UserSvc.ResetPasswordAsync(u.Id);
            LastGeneratedPassword = newPassword;
            LastGeneratedPasswordFor = u.Username;
        }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }

    private async Task DeleteAsync(UserDto u)
    {
        try { await UserSvc.DeleteAsync(u.Id); await LoadAsync(); }
        catch (ApiException ex) { ErrorMessage = ex.Message; }
    }
}
